function Glow({
  size,
  left,
  top,
  opacity = 0.25,
}: {
  size: number;
  left: number;
  top: number;
  opacity?: number;
}) {
  return (
    <View
      pointerEvents="none"
      style={[
        styles.glow,
        {
          width: size,
          height: size,
          borderRadius: size / 2,
          left,
          top,
          opacity,
        },
      ]}
    />
  );
}

export default function SubjectGameScreen() {
  const router = useRouter();
  const params = useLocalSearchParams<{ subject?: string }>();

  const subject = String(params.subject ?? 'vedic').toLowerCase();

  const world = WORLDS[subject] ?? WORLDS.vedic;

  const [level, setLevel] = useState(0);
  const [guideVisible, setGuideVisible] = useState(true);
  const [completed, setCompleted] = useState(false);
  const [stars, setStars] = useState<boolean[]>(
    world.levels.map(() => false),
  );

  const current = world.levels[level];

  const progress = useMemo(() => {
    return stars.filter(Boolean).length;
  }, [stars]);

  const finishLevel = async () => {
    const starId = `${subject}-${level + 1}`;

    await collectStar({
      id: starId,
      subject,
      level: level + 1,
      title: current.title,
    });

    setStars((previous) => {
      const next = [...previous];
      next[level] = true;
      return next;
    });

    setCompleted(true);
  };

  const nextLevel = () => {
    if (level < world.levels.length - 1) {
      setLevel((previous) => previous + 1);
      setCompleted(false);
      setGuideVisible(true);
    }
  };

  const previousLevel = () => {
    if (level > 0) {
      setLevel((previous) => previous - 1);
      setCompleted(false);
      setGuideVisible(true);
    }
  };

  return (
    <View style={styles.container}>
      <Stack.Screen options={{ headerShown: false }} />

      <View style={styles.background}>
        <Glow size={330} left={-130} top={-80} />
        <Glow size={300} left={width - 130} top={height * 0.18} />
        <Glow size={360} left={width * 0.25} top={height * 0.65} />

        <View style={[styles.wall, styles.wallOne]} />
        <View style={[styles.wall, styles.wallTwo]} />
        <View style={[styles.wall, styles.wallThree]} />
      </View>

      <SafeAreaView style={styles.safe}>
        <View style={styles.topBar}>
          <Pressable
            style={styles.backButton}
            onPress={() => router.back()}
          >
            <Text style={styles.backText}>← World</Text>
          </Pressable>

          <View style={styles.titleBox}>
            <Text style={styles.symbol}>{world.symbol}</Text>
            <Text style={styles.worldTitle}>{world.title}</Text>
          </View>

          <View style={styles.progressBox}>
            <Text style={styles.progressText}>
              {progress}/{world.levels.length}
            </Text>
            <Text style={styles.starTiny}>⭐</Text>
          </View>
        </View>

        <View style={styles.starMap}>
          {world.levels.map((item, index) => (
            <Pressable
              key={item.title}
              onPress={() => {
                setLevel(index);
                setCompleted(false);
                setGuideVisible(true);
              }}
              style={[
                styles.levelStar,
                index === level && styles.currentStar,
              ]}
            >
              <Text style={styles.starText}>
                {stars[index] ? '★' : '☆'}
              </Text>
              <Text style={styles.levelNumber}>
                {index + 1}
              </Text>
            </Pressable>
          ))}
        </View>

        <ScrollView
          contentContainerStyle={styles.content}
          showsVerticalScrollIndicator={false}
        >
          <Text style={styles.levelLabel}>LEVEL {level + 1}</Text>

          <Text style={styles.levelTitle}>{current.title}</Text>

          <Text style={styles.objective}>
            {current.objective}
          </Text>

          {guideVisible && (
            <View style={styles.guideCard}>
              <View style={styles.guideHeader}>
                <Text style={styles.guideIcon}>📖</Text>
                <Text style={styles.guideTitle}>GUIDE</Text>

                <Pressable
                  onPress={() => setGuideVisible(false)}
                  style={styles.closeGuide}
                >
                  <Text style={styles.closeText}>×</Text>
                </Pressable>
              </View>

              <Text style={styles.guideText}>
                {current.guide}
              </Text>

              <Pressable
                style={styles.startButton}
                onPress={() => setGuideVisible(false)}
              >
                <Text style={styles.startText}>I'M READY →</Text>
              </Pressable>
            </View>
          )}

          {!guideVisible && !completed && (
            <GameArea
              type={current.gameType}
              onComplete={finishLevel}
            />
          )}

          {completed && (
            <View style={styles.completeCard}>
              <Text style={styles.bigStar}>★</Text>

              <Text style={styles.completeTitle}>
                STAR DISCOVERED
              </Text>

              <Text style={styles.completeText}>
                You explored {current.title}.
              </Text>

              <View style={styles.collectedStar}>
                <Text style={styles.collectedStarText}>
                  ⭐
                </Text>
                <Text style={styles.collectedText}>
                  Added to your constellation
                </Text>
              </View>

              <Pressable
                style={styles.nextButton}
                onPress={nextLevel}
              >
                <Text style={styles.nextText}>
                  {level < world.levels.length - 1
                    ? 'NEXT LEVEL →'
                    : 'RETURN TO WORLD'}
                </Text>
              </Pressable>
            </View>
          )}
        </ScrollView>

        <View style={styles.bottomBar}>
          <Pressable
            style={[
              styles.navButton,
              level === 0 && styles.disabled,
            ]}
            disabled={level === 0}
            onPress={previousLevel}
          >
            <Text style={styles.navText}>← Previous</Text>
          </Pressable>

          <Pressable
            style={styles.guideButton}
            onPress={() => setGuideVisible(true)}
          >
            <Text style={styles.guideButtonText}>📖 Guide</Text>
          </Pressable>

          <Pressable
            style={[
              styles.navButton,
              level === world.levels.length - 1 && styles.disabled,
            ]}
            disabled={level === world.levels.length - 1}
            onPress={nextLevel}
          >
            <Text style={styles.navText}>Next →</Text>
          </Pressable>
        </View>
      </SafeAreaView>
    </View>
  );
}

function GameArea({
  type,
  onComplete,
}: {
  type: GameType;
  onComplete: () => void;
}) {
  if (type === 'drag') {
    return <DragGame onComplete={onComplete} />;
  }

  if (type === 'rhythm') {
    return <RhythmGame onComplete={onComplete} />;
  }

  if (type === 'physics') {
    return <PhysicsGame onComplete={onComplete} />;
  }

  if (type === 'drawing') {
    return <DrawingGame onComplete={onComplete} />;
  }

  return <ExploreGame onComplete={onComplete} />;
}

function DragGame({
  onComplete,
}: {
  onComplete: () => void;
}) {
  const [placed, setPlaced] = useState(false);

  const panResponder = PanResponder.create({
    onStartShouldSetPanResponder: () => true,

    onPanResponderRelease: (_, gesture) => {
      const closeEnough =
        gesture.moveX > width * 0.35 &&
        gesture.moveX < width * 0.85 &&
        gesture.moveY > height * 0.35 &&
        gesture.moveY < height * 0.75;

      if (closeEnough) {
        setPlaced(true);
      }
    },
  });

  return (
    <View style={styles.gameCard}>
      <Text style={styles.gameHint}>
        Drag the glowing part into the machine.
      </Text>

      <View style={styles.machine}>
        <Text style={styles.machineText}>⚙️</Text>
        <Text style={styles.machineLabel}>
          MACHINE
        </Text>
      </View>

      {!placed ? (
        <View
          {...panResponder.panHandlers}
          style={styles.draggable}
        >
          <Text style={styles.dragText}>⚙</Text>
        </View>
      ) : (
        <View style={styles.successObject}>
          <Text style={styles.dragText}>⚙</Text>
        </View>
      )}

      {placed && (
        <Pressable
          style={styles.completeButton}
          onPress={onComplete}
        >
          <Text style={styles.completeButtonText}>
            MACHINE ACTIVATED ✓
          </Text>
        </Pressable>
      )}
    </View>
  );
}

function RhythmGame({
  onComplete,
}: {
  onComplete: () => void;
}) {
  const [sequence] = useState([0, 1, 0]);
  const [input, setInput] = useState<number[]>([]);

  const tap = (value: number) => {
    const next = [...input, value];
    setInput(next);

    if (next.length === sequence.length) {
      const correct = next.every(
        (item, index) => item === sequence[index],
      );

      if (correct) {
        setTimeout(onComplete, 300);
      } else {
        setInput([]);
      }
    }
  };

  return (
    <View style={styles.gameCard}>
      <Text style={styles.gameHint}>
        Repeat the rhythm: 🔵 → 🟣 → 🔵
      </Text>

      <View style={styles.rhythmRow}>
        <Pressable
          style={styles.rhythmBlue}
          onPress={() => tap(0)}
        >
          <Text style={styles.rhythmText}>●</Text>
        </Pressable>

        <Pressable
          style={styles.rhythmPurple}
          onPress={() => tap(1)}
        >
          <Text style={styles.rhythmText}>●</Text>
        </Pressable>
      </View>

      <Text style={styles.rhythmProgress}>
        {input.length}/3 beats
      </Text>
    </View>
  );
}

function PhysicsGame({
  onComplete,
}: {
  onComplete: () => void;
}) {
  const [force, setForce] = useState(0);

  const hitTarget = force >= 70 && force <= 85;

  return (
    <View style={styles.gameCard}>
      <Text style={styles.gameHint}>
        Experiment with force until the object reaches the target.
      </Text>

      <View style={styles.physicsTrack}>
        <View
          style={[
            styles.physicsObject,
            {
              left: `${Math.min(force, 92)}%`,
            },
          ]}
        >
          <Text style={styles.physicsObjectText}>●</Text>
        </View>

        <View style={styles.physicsTarget}>
          <Text style={styles.physicsTargetText}>◎</Text>
        </View>
      </View>

      <View style={styles.forceButtons}>
        {[20, 40, 60, 75, 90].map((value) => (
          <Pressable
            key={value}
            style={styles.forceButton}
            onPress={() => setForce(value)}
          >
            <Text style={styles.forceText}>{value}</Text>
          </Pressable>
        ))}
      </View>

      {hitTarget && (
        <Pressable
          style={styles.completeButton}
          onPress={onComplete}
        >
          <Text style={styles.completeButtonText}>
            EXPERIMENT COMPLETE ✓
          </Text>
        </Pressable>
      )}
    </View>
  );
}

function DrawingGame({
  onComplete,
}: {
  onComplete: () => void;
}) {
  const [points, setPoints] = useState<number[]>([]);

  const addPoint = (point: number) => {
    if (!points.includes(point)) {
      const next = [...points, point];
      setPoints(next);

      if (next.length === 4) {
        setTimeout(onComplete, 300);
      }
    }
  };

  return (
    <View style={styles.gameCard}>
      <Text style={styles.gameHint}>
        Connect the four glowing points.
      </Text>

      <View style={styles.drawingBoard}>
        {[0, 1, 2, 3].map((point) => (
          <Pressable
            key={point}
            onPress={() => addPoint(point)}
            style={[
              styles.drawingPoint,
              [
                styles.pointOne,
                styles.pointTwo,
                styles.pointThree,
                styles.pointFour,
              ][point],
              points.includes(point) && styles.pointSelected,
            ]}
          >
            <Text style={styles.pointText}>✦</Text>
          </Pressable>
        ))}
      </View>

      <Text style={styles.rhythmProgress}>
        {points.length}/4 points
      </Text>
    </View>
  );
}

function ExploreGame({
  onComplete,
}: {
  onComplete: () => void;
}) {
  const [found, setFound] = useState<number[]>([]);

  const discover = (id: number) => {
    if (!found.includes(id)) {
      const next = [...found, id];
      setFound(next);

      if (next.length === 3) {
        setTimeout(onComplete, 300);
      }
    }
  };

  return (
    <View style={styles.gameCard}>
      <Text style={styles.gameHint}>
        Explore the scene and discover three hidden connections.
      </Text>

      <View style={styles.exploreScene}>
        <Pressable
          style={styles.exploreOne}
          onPress={() => discover(1)}
        >
          <Text style={styles.exploreEmoji}>🌱</Text>
        </Pressable>

        <Pressable
          style={styles.exploreTwo}
          onPress={() => discover(2)}
        >
          <Text style={styles.exploreEmoji}>💧</Text>
        </Pressable>

        <Pressable
          style={styles.exploreThree}
          onPress={() => discover(3)}
        >
          <Text style={styles.exploreEmoji}>🦋</Text>
        </Pressable>
      </View>

      <Text style={styles.rhythmProgress}>
        {found.length}/3 discoveries
      </Text>
    </View>
  );
}

