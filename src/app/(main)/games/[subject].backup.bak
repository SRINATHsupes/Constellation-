  | 'rhythm'
  | 'physics'
  | 'drawing'
  | 'explore';

type Level = {
  title: string;
  guide: string;
  objective: string;
  gameType: GameType;
};

type World = {
  title: string;
  symbol: string;
  colors: string[];
  description: string;
  levels: Level[];
