function GameButton({
  children,
  onPress,
  disabled = false,
}: {
  children: React.ReactNode;
  onPress: () => void;
  disabled?: boolean;
}) {
  return (
    <Pressable
      disabled={disabled}
      onPress={onPress}
      style={({ pressed }) => [
        styles.button,
        disabled && styles.buttonDisabled,
        pressed && !disabled && styles.buttonPressed,
      ]}
    >
      <Text style={styles.buttonText}>{children}</Text>
    </Pressable>
  );
}

function NikhilamGame({ onComplete }: { onComplete: () => void }) {
  const [step, setStep] = useState(0);

  const problems = [
    { a: 98, b: 97, answer: 9506 },
    { a: 97, b: 96, answer: 9312 },
    { a: 99, b: 96, answer: 9504 },
  ];

  const problem = problems[step];

  return (
    <View style={styles.gameBox}>
      <Text style={styles.gameTitle}>NIKHILAM MARKET LOCK</Text>

      <Text style={styles.gameText}>
        These prices are close to 100. Use 100 as your base.
      </Text>

      <View style={styles.numberCard}>
        <Text style={styles.bigNumber}>
          {problem.a} × {problem.b}
        </Text>
      </View>

      <Text style={styles.formula}>
        Differences from 100:
        {'\n'}
        {problem.a - 100} and {problem.b - 100}
      </Text>

      <Text style={styles.hint}>
        Think about the base and the small differences.
      </Text>

      {[9506, 9312, 9504].map((value) => (
        <GameButton
          key={value}
          onPress={() => {
            if (value === problem.answer) {
              if (step < problems.length - 1) {
                setStep(step + 1);
              } else {
                onComplete();
              }
            }
          }}
        >
          {value}
        </GameButton>
      ))}

      <Text style={styles.progressText}>
        Lock {step + 1} / {problems.length}
      </Text>
    </View>
  );
}

function ManufacturingGame({ onComplete }: { onComplete: () => void }) {
  const [order, setOrder] = useState<string[]>([]);

  const parts = ['RAW MATERIAL', 'MACHINE', 'GEAR', 'INSPECTION'];

  const addPart = (part: string) => {
    if (order.includes(part)) return;

    const next = [...order, part];
    setOrder(next);

    if (
      next.join('|') ===
      'RAW MATERIAL|MACHINE|GEAR|INSPECTION'
    ) {
      onComplete();
    }
  };

  return (
    <View style={styles.gameBox}>
      <Text style={styles.gameTitle}>MINI FACTORY</Text>
      <Text style={styles.gameText}>
        Build the production line in a sensible sequence.
      </Text>

      <View style={styles.factoryLine}>
        {order.length === 0 ? (
          <Text style={styles.emptyLine}>Tap parts to build the line</Text>
        ) : (
          order.map((part) => (
            <View key={part} style={styles.factoryPart}>
              <Text style={styles.factoryPartText}>{part}</Text>
            </View>
          ))
        )}
      </View>

      {parts.map((part) => (
        <GameButton
          key={part}
          disabled={order.includes(part)}
          onPress={() => addPart(part)}
        >
          {part}
        </GameButton>
      ))}
    </View>
  );
}

function MusicGame({ onComplete }: { onComplete: () => void }) {
  const pattern = [0, 1, 0, 0, 1];
  const [input, setInput] = useState<number[]>([]);

  const tap = (value: number) => {
    const next = [...input, value];

    if (next[next.length - 1] !== pattern[next.length - 1]) {
      setInput([]);
      return;
    }

    setInput(next);

    if (next.length === pattern.length) {
      onComplete();
    }
  };

  return (
    <View style={styles.gameBox}>
      <Text style={styles.gameTitle}>SOUND LAB</Text>
      <Text style={styles.gameText}>
        Reproduce the rhythm. Tap the two surfaces as the pattern plays.
      </Text>

      <View style={styles.rhythm}>
        {pattern.map((beat, index) => (
          <View
            key={index}
            style={[
              styles.beat,
              input.length > index && styles.beatDone,
            ]}
          >
            <Text style={styles.beatText}>
              {beat === 0 ? '●' : '◆'}
            </Text>
          </View>
        ))}
      </View>

      <View style={styles.row}>
        <Pressable
          onPress={() => tap(0)}
          style={styles.soundPad}
        >
          <Text style={styles.padText}>TAP</Text>
        </Pressable>

        <Pressable
          onPress={() => tap(1)}
          style={styles.soundPad}
        >
          <Text style={styles.padText}>CLAP</Text>
        </Pressable>
      </View>

      <Text style={styles.hint}>
        A repeated pattern is rhythm. Real instruments create these patterns
        through vibration.
      </Text>
    </View>
  );
}

function NutritionGame({ onComplete }: { onComplete: () => void }) {
  const [items, setItems] = useState<string[]>([]);

  const foods = [
    ['🥕', 'Vegetable'],
    ['🍎', 'Fruit'],
    ['🫘', 'Protein'],
    ['🌾', 'Whole grain'],
    ['🥤', 'Sugary drink'],
    ['🍟', 'Fried junk food'],
  ];

  const choose = (food: string) => {
    if (items.includes(food)) return;

    const next = [...items, food];
    setItems(next);

    const good =
      next.includes('Vegetable') &&
      next.includes('Fruit') &&
      next.includes('Protein') &&
      next.includes('Whole grain');

    if (good) {
      onComplete();
    }
  };

  return (
    <View style={styles.gameBox}>
      <Text style={styles.gameTitle}>BUILD A GOOD MEAL</Text>

      <Text style={styles.gameText}>
        Create a varied meal. You can also tap foods you would limit rather
        than make the whole meal from them.
      </Text>

      <View style={styles.plate}>
        {items.length === 0 ? (
          <Text style={styles.emptyLine}>Your plate is empty</Text>
        ) : (
          items.map((item) => (
            <Text key={item} style={styles.plateItem}>
              {foods.find((food) => food[1] === item)?.[0]} {item}
            </Text>
          ))
        )}
      </View>

      <View style={styles.foodGrid}>
        {foods.map(([emoji, name]) => (
          <Pressable
            key={name}
            onPress={() => choose(name)}
            style={[
              styles.foodCard,
              items.includes(name) && styles.foodSelected,
            ]}
          >
            <Text style={styles.foodEmoji}>{emoji}</Text>
            <Text style={styles.foodName}>{name}</Text>
          </Pressable>
        ))}
      </View>
    </View>
  );
}

function HumanityGame({ onComplete }: { onComplete: () => void }) {
  const [resources, setResources] = useState({
    water: false,
    food: false,
    communication: false,
    helper: false,
  });

  const choose = (key: keyof typeof resources) => {
    const next = { ...resources, [key]: true };
    setResources(next);

    if (
      next.water &&
      next.food &&
      next.communication &&
      next.helper
    ) {
      onComplete();
    }
  };

  return (
    <View style={styles.gameBox}>
      <Text style={styles.gameTitle}>COMMUNITY RESCUE</Text>

      <Text style={styles.gameText}>
        A neighbourhood needs help. Build a response by considering people,
        supplies and communication.
      </Text>

      {[
        ['water', '💧 Water'],
        ['food', '🥫 Food'],
        ['communication', '📢 Communication'],
        ['helper', '🤝 A helper'],
      ].map(([key, label]) => (
        <GameButton
          key={key}
          disabled={resources[key as keyof typeof resources]}
          onPress={() =>
            choose(key as keyof typeof resources)
          }
        >
          {label}
        </GameButton>
      ))}

      <Text style={styles.hint}>
        Real communities solve problems by coordinating people and resources.
      </Text>
    </View>
  );
}

function ElectronicsGame({ onComplete }: { onComplete: () => void }) {
  const [states, setStates] = useState([false, false, false]);
  const [showCode, setShowCode] = useState(false);

  const toggle = (index: number) => {
    const next = [...states];
    next[index] = !next[index];
    setStates(next);

    if (next.every(Boolean)) {
      setShowCode(true);
    }
  };

  return (
    <View style={styles.gameBox}>
      <Text style={styles.gameTitle}>WATER LOGIC → ELECTRONICS</Text>

      <Text style={styles.gameText}>
        Think of each pipe as a switch. Open = 1. Blocked = 0.
      </Text>

      <View style={styles.pipeArea}>
        {[0, 1, 2].map((index) => (
          <Pressable
            key={index}
            onPress={() => toggle(index)}
            style={[
              styles.pipe,
              states[index] && styles.pipeOpen,
            ]}
          >
            <Text style={styles.pipeText}>
              {states[index] ? '1  OPEN' : '0  BLOCKED'}
            </Text>
          </Pressable>
        ))}
      </View>

      <Text style={styles.flowText}>
        {states.every(Boolean)
          ? '💧 WATER REACHES THE OUTPUT'
          : '🚫 WATER CANNOT REACH THE OUTPUT'}
      </Text>

      {showCode && (
        <View style={styles.codeCard}>
          <Text style={styles.codeTitle}>
            Now the same idea enters computing.
          </Text>
          <Text style={styles.codeText}>a = 65</Text>
          <Text style={styles.codeSmall}>
            Numbers can represent information. 65 is the ASCII code for A.
          </Text>
          <GameButton onPress={onComplete}>
            ENTER CODING
          </GameButton>
        </View>
      )}
    </View>
  );
}

function PhysicsGame({ onComplete }: { onComplete: () => void }) {
  const [slope, setSlope] = useState(1);
  const [surface, setSurface] = useState(1);

  const canFinish = slope === 3 && surface === 1;

  return (
    <View style={styles.gameBox}>
      <Text style={styles.gameTitle}>PHYSICS WORKSHOP</Text>

      <Text style={styles.gameText}>
        Change the ramp and surface. Observe how motion changes.
      </Text>

      <View style={styles.ramp}>
        <View
          style={[
            styles.rampObject,
            { transform: [{ translateX: slope * 25 }] },
          ]}
        >
          <Text style={styles.objectEmoji}>⚪</Text>
        </View>
        <Text style={styles.rampText}>
          Ramp steepness: {slope}
        </Text>
      </View>

      <Text style={styles.sectionLabel}>Change the ramp</Text>

      <View style={styles.row}>
        {[1, 2, 3].map((value) => (
          <Pressable
            key={value}
            onPress={() => setSlope(value)}
            style={[
              styles.smallButton,
              slope === value && styles.smallButtonSelected,
            ]}
          >
            <Text style={styles.smallButtonText}>{value}</Text>
          </Pressable>
        ))}
      </View>

      <Text style={styles.sectionLabel}>Surface</Text>

      <View style={styles.row}>
        <Pressable
          onPress={() => setSurface(1)}
          style={[
            styles.smallButton,
            surface === 1 && styles.smallButtonSelected,
          ]}
        >
          <Text style={styles.smallButtonText}>SMOOTH</Text>
        </Pressable>

        <Pressable
          onPress={() => setSurface(2)}
          style={[
            styles.smallButton,
            surface === 2 && styles.smallButtonSelected,
          ]}
        >
          <Text style={styles.smallButtonText}>ROUGH</Text>
        </Pressable>
      </View>

      <Text style={styles.observation}>
        {surface === 1
          ? 'The smooth surface offers less resistance.'
          : 'The rough surface offers more resistance.'}
      </Text>

      {canFinish && (
        <GameButton onPress={onComplete}>
          OBSERVE THE RESULT
        </GameButton>
      )}
    </View>
  );
}

function ArtsGame({ onComplete }: { onComplete: () => void }) {
  const [selected, setSelected] = useState<string[]>([]);

  const structures = [
    ['○', 'Circle'],
    ['△', 'Triangle'],
    ['□', 'Square'],
    ['▭', 'Rectangle'],
  ];

  const choose = (name: string) => {
    const next = selected.includes(name)
      ? selected
      : [...selected, name];

    setSelected(next);

    if (
      next.includes('Circle') &&
      next.includes('Triangle') &&
      next.includes('Square')
    ) {
      onComplete();
    }
  };

  return (
    <View style={styles.gameBox}>
      <Text style={styles.gameTitle}>ARTS DESIGN STUDIO</Text>

      <Text style={styles.gameText}>
        Look at a drawing as structures. Choose the forms you could combine
        to construct it.
      </Text>

      <View style={styles.drawingPreview}>
        <Text style={styles.houseRoof}>△</Text>
        <Text style={styles.houseBody}>□</Text>
        <Text style={styles.houseDoor}>▯</Text>
        <Text style={styles.sun}>○</Text>
      </View>

      <Text style={styles.hint}>
        This house is not just one picture. It is a collection of structures.
      </Text>

      <View style={styles.shapeGrid}>
        {structures.map(([shape, name]) => (
          <Pressable
            key={name}
            onPress={() => choose(name)}
            style={[
              styles.shapeCard,
              selected.includes(name) && styles.shapeSelected,
            ]}
          >
            <Text style={styles.shapeSymbol}>{shape}</Text>
            <Text style={styles.shapeName}>{name}</Text>
          </Pressable>
        ))}
      </View>

      <Text style={styles.hint}>
        Next step: draw the same structures yourself on paper.
      </Text>
    </View>
  );
}

function NatureGame({ onComplete }: { onComplete: () => void }) {
  const [links, setLinks] = useState<string[]>([]);

  const organisms = [
    ['☀️', 'Sun'],
    ['🌱', 'Plant'],
    ['🐛', 'Insect'],
    ['🐦', 'Bird'],
    ['💧', 'Water'],
  ];

  const choose = (name: string) => {
    const next = links.includes(name)
      ? links
      : [...links, name];

    setLinks(next);

    if (
      next.includes('Sun') &&
      next.includes('Plant') &&
      next.includes('Insect') &&
      next.includes('Bird') &&
      next.includes('Water')
    ) {
      onComplete();
    }
  };

  return (
    <View style={styles.gameBox}>
      <Text style={styles.gameTitle}>ECOSYSTEM EXPLORER</Text>

      <Text style={styles.gameText}>
        An ecosystem is a network of relationships. Connect the pieces needed
        to understand this small ecosystem.
      </Text>

      {organisms.map(([emoji, name]) => (
        <Pressable
          key={name}
          onPress={() => choose(name)}
          style={[
            styles.ecoCard,
            links.includes(name) && styles.ecoSelected,
          ]}
        >
          <Text style={styles.ecoEmoji}>{emoji}</Text>
          <Text style={styles.ecoName}>{name}</Text>
          <Text style={styles.ecoMark}>
            {links.includes(name) ? '✓ observed' : 'tap to observe'}
          </Text>
        </Pressable>
      ))}

      <Text style={styles.hint}>
        Sun → plants → animals is one simplified pathway. Real ecosystems
        contain many interconnected relationships.
      </Text>
    </View>
  );
}

function GameArea({
  subject,
  onComplete,
}: {
  subject: string;
  onComplete: () => void;
}) {
  switch (subject) {
    case 'vedic':
      return <NikhilamGame onComplete={onComplete} />;
    case 'manufacturing':
      return <ManufacturingGame onComplete={onComplete} />;
    case 'music':
      return <MusicGame onComplete={onComplete} />;
    case 'nutrition':
      return <NutritionGame onComplete={onComplete} />;
    case 'humanity':
      return <HumanityGame onComplete={onComplete} />;
    case 'electronics':
      return <ElectronicsGame onComplete={onComplete} />;
    case 'physics':
      return <PhysicsGame onComplete={onComplete} />;
    case 'arts':
      return <ArtsGame onComplete={onComplete} />;
    case 'nature':
      return <NatureGame onComplete={onComplete} />;
    default:
      return null;
  }
}

export default function SubjectGameScreen() {
  const params = useLocalSearchParams<{ subject?: string }>();
  const router = useRouter();

  const subject =
    typeof params.subject === 'string'
      ? params.subject
      : 'vedic';

  const world = WORLDS[subject] ?? WORLDS.vedic;

  const [levelIndex, setLevelIndex] = useState(0);
  const [showGuide, setShowGuide] = useState(false);
  const [completed, setCompleted] = useState(false);
  const [missionDone, setMissionDone] = useState(false);
  const [collected, setCollected] = useState<string[]>([]);

  const level = world.levels[levelIndex];

  useEffect(() => {
    let mounted = true;

    getCollectedStars().then((stars) => {
      if (mounted) {
        setCollected(stars.map((star) => star.id));
      }
    });

    return () => {
      mounted = false;
    };
  }, []);

  const starId = level.id;

  const isCollected = useMemo(
    () => collected.includes(starId),
    [collected, starId],
  );

  const finishGame = () => {
    setCompleted(true);
    setMissionDone(false);
  };

  const completeMission = async () => {
    await collectStar({
      id: starId,
      subject,
      level: levelIndex + 1,
      title: level.title,
    });

    setCollected((previous) =>
      previous.includes(starId)
        ? previous
        : [...previous, starId],
    );

    setMissionDone(true);
  };

  const nextLevel = () => {
    if (levelIndex < world.levels.length - 1) {
      setLevelIndex(levelIndex + 1);
      setCompleted(false);
      setMissionDone(false);
      setShowGuide(false);
    }
  };

  const previousLevel = () => {
    if (levelIndex > 0) {
      setLevelIndex(levelIndex - 1);
      setCompleted(false);
      setMissionDone(false);
      setShowGuide(false);
    }
  };

  return (
    <View style={styles.container}>
      <Stack.Screen
        options={{
          headerShown: false,
          animation: 'fade',
        }}
      />

      <View style={styles.backgroundGlowOne} />
      <View style={styles.backgroundGlowTwo} />

      <ScrollView
        contentContainerStyle={styles.scroll}
        showsVerticalScrollIndicator={false}
      >
        <View style={styles.topBar}>
          <Pressable
            onPress={() => router.back()}
            style={styles.spaceButton}
          >
            <Text style={styles.spaceButtonText}>
              ✦ BACK TO SPACE
            </Text>
          </Pressable>

          <Text style={styles.levelCounter}>
            {levelIndex + 1} / {world.levels.length}
          </Text>
        </View>

        <View style={styles.hero}>
          <Text style={styles.subjectIcon}>{world.icon}</Text>
          <Text style={styles.subjectTitle}>{world.title}</Text>
          <Text style={styles.subjectDescription}>
            {world.description}
          </Text>
        </View>

        <View style={styles.levelRow}>
          {world.levels.map((item, index) => {
            const itemCollected = collected.includes(item.id);

            return (
              <Pressable
                key={item.id}
                onPress={() => {
                  setLevelIndex(index);
                  setCompleted(false);
                  setMissionDone(false);
                }}
                style={[
                  styles.levelOrb,
                  index === levelIndex && styles.levelOrbActive,
                ]}
              >
                <Text style={styles.levelOrbText}>
                  {itemCollected ? '★' : '☆'}
                </Text>
                <Text style={styles.levelOrbNumber}>
                  {index + 1}
                </Text>
              </Pressable>
            );
          })}
        </View>

        <View style={styles.titleCard}>
          <Text style={styles.levelLabel}>DISCOVERY {levelIndex + 1}</Text>
          <Text style={styles.levelTitle}>{level.title}</Text>
        </View>

        {showGuide && (
          <View style={styles.guideCard}>
            <Text style={styles.guideLabel}>GUIDE</Text>
            <Text style={styles.guideText}>{level.guide}</Text>
          </View>
        )}

        {!completed ? (
          <GameArea
            subject={subject}
            onComplete={finishGame}
          />
        ) : !missionDone ? (
          <View style={styles.missionCard}>
            <Text style={styles.missionIcon}>🌍</Text>
            <Text style={styles.missionTitle}>
              TAKE IT OUTSIDE
            </Text>

            <Text style={styles.missionText}>
              {level.mission}
            </Text>

            <Text style={styles.missionSmall}>
              The digital game introduced the idea. Now connect it to
              something real.
            </Text>

            <GameButton onPress={completeMission}>
              I EXPLORED IT
            </GameButton>
          </View>
        ) : (
          <View style={styles.starCard}>
            <Text style={styles.starSymbol}>★</Text>
            <Text style={styles.starTitle}>
              STAR DISCOVERED
            </Text>

            <Text style={styles.starText}>
              {level.title} is now part of your constellation.
            </Text>

            {levelIndex < world.levels.length - 1 ? (
              <GameButton onPress={nextLevel}>
                NEXT DISCOVERY
              </GameButton>
            ) : (
              <GameButton onPress={() => router.back()}>
                ✦ RETURN TO SPACE
              </GameButton>
            )}
          </View>
        )}

        <View style={styles.bottomBar}>
          <Pressable
            disabled={levelIndex === 0}
            onPress={previousLevel}
            style={[
              styles.navButton,
              levelIndex === 0 && styles.navDisabled,
            ]}
          >
            <Text style={styles.navText}>← Previous</Text>
          </Pressable>

          <Pressable
            onPress={() => setShowGuide((value) => !value)}
            style={styles.navButton}
          >
            <Text style={styles.navText}>
              {showGuide ? 'Hide Guide' : 'Guide'}
            </Text>
          </Pressable>

          <Pressable
            disabled={levelIndex === world.levels.length - 1}
            onPress={nextLevel}
            style={[
              styles.navButton,
              levelIndex === world.levels.length - 1 &&
                styles.navDisabled,
            ]}
          >
            <Text style={styles.navText}>Next →</Text>
          </Pressable>
        </View>

        {isCollected && (
          <Text style={styles.collectedText}>
            ★ You already discovered this star.
          </Text>
        )}
      </ScrollView>
    </View>
  );
}

