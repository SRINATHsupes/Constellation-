  {
    id: 'vedic',
    name: 'VEDIC MATHS',
    position: [-4.8, 2.7, -1.5],
    color: '#f5c451',
  },
  {
    id: 'physics',
    name: 'PHYSICS',
    position: [0.2, 4.0, -2.0],
    color: '#5edcff',
  },
  {
    id: 'nutrition',
    name: 'NUTRITION',
    position: [4.5, 2.0, -1.0],
    color: '#69e6bd',
  },
  {
    id: 'electronics',
    name: 'ELECTRONICS',
    position: [3.8, -2.7, -0.5],
    color: '#9b6cff',
  },
  {
    id: 'drawing',
    name: 'DRAWING',
    position: [-0.8, -3.7, -1.8],
    color: '#f36bd8',
  },
  {
    id: 'music',
    name: 'MUSIC',
    position: [-4.8, -1.7, -1.0],
