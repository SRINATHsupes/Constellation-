    letterSpacing: 0.8,
    color: COLORS.purpleDark,
  },

  status: {
    marginLeft: 'auto',
    width: 36,
    height: 36,
    borderRadius: 18,
    backgroundColor: COLORS.paper,
    alignItems: 'center',
    justifyContent: 'center',
  },

  statusText: {
    color: COLORS.green,
    fontSize: 18,
  },

  game: {
    flex: 1,
    overflow: 'hidden',
    borderTopLeftRadius: 28,
    borderTopRightRadius: 28,
    backgroundColor: COLORS.background,
  },

  overlay: {
    ...StyleSheet.absoluteFill,
    justifyContent: 'space-between',
    padding: 18,
  },

  message: {
    alignSelf: 'center',
    maxWidth: '82%',
    paddingHorizontal: 18,
    paddingVertical: 11,
    borderRadius: 18,
    backgroundColor: 'rgba(255,253,249,0.94)',
  },

  messageText: {
    color: COLORS.charcoal,
    fontSize: 13,
    fontWeight: '600',
    textAlign: 'center',
  },

  controls: {
    flexDirection: 'row',
    alignItems: 'flex-end',
    justifyContent: 'space-between',
  },

  dpad: {
    alignItems: 'center',
  },

  middleRow: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: 8,
  },

  control: {
    width: 58,
    height: 58,
    borderRadius: 20,
    backgroundColor: 'rgba(255,253,249,0.94)',
    alignItems: 'center',
    justifyContent: 'center',
    marginVertical: 4,
  },

  controlText: {
    fontSize: 23,
    color: COLORS.purpleDark,
    fontWeight: '800',
  },

  stop: {
    width: 48,
    height: 48,
    borderRadius: 24,
    backgroundColor: 'rgba(220,207,244,0.94)',
    alignItems: 'center',
    justifyContent: 'center',
  },

  stopText: {
    fontSize: 16,
    color: COLORS.purpleDark,
  },

  interact: {
    width: 126,
    height: 58,
    borderRadius: 22,
    backgroundColor: COLORS.purple,
    alignItems: 'center',
    justifyContent: 'center',
  },

  interactText: {
    color: '#FFFFFF',
    fontSize: 13,
    fontWeight: '800',
    letterSpacing: 0.8,
  },
});
