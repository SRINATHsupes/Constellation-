  {
    id: 1,
    title: 'Number Patterns',
    completed: false,
    position: [-1.1, 0.7, 0],
  },
  {
    id: 2,
    title: 'Multiplication',
    completed: false,
    position: [-0.5, 1.0, -0.2],
  },
  {
    id: 3,
    title: 'Division',
    completed: false,
    position: [0.1, 0.8, 0.1],
  },
  {
    id: 4,
    title: 'Mental Calculation',
    completed: false,
    position: [0.7, 1.0, -0.3],
  },
  {
    id: 5,
    title: 'Speed & Tricks',
    completed: false,
    position: [1.1, 0.4, 0.2],
  },
];

