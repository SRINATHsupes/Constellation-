import { GLView } from 'expo-gl';
import { useRouter } from 'expo-router';
import { useEffect, useRef, useState } from 'react';
import {
  PanResponder,
  Pressable,
  StyleSheet,
  Text,
  View,
} from 'react-native';
import * as THREE from 'three';

type LessonStar = {
  id: number;
  title: string;
  completed: boolean;
  position: [number, number, number];
};

type Subject = {
  id: string;
  name: string;
  position: [number, number, number];
  color: string;
};

